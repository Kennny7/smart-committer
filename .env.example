# Ollama connection
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Commit defaults
SMART_COMMITTER_MODE=single       # Options: single, all, grouped
SMART_COMMITTER_STYLE=conventional # Options: conventional, simple, gitmoji
SMART_COMMITTER_CONCURRENCY=4     # Worker threads for Ollama generation
SMART_COMMITTER_SECRET_SCAN=true  # Detect credentials before committing

# Microservice REST API daemon
SMART_COMMITTER_HOST=127.0.0.1
SMART_COMMITTER_PORT=8000

# Logging & preview limits
LOG_DIR=~/.smart-committer/logs
MAX_FILE_PREVIEW=2500
MAX_DIFF_PREVIEW=3500
